generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  BARBER
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
}

model Barbershop {
  id        String  @id @default(uuid())
  slug      String  @unique
  name      String
  phone     String?
  openTime  String
  openDays  String[]
  closeTime String

  maxBarbers Int @default(2) // A CATRACA: Limite do plano básico

  users        UserBarbershop[]
  barbers      Barber[]
  services     Service[]
  clients      Client[]
  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String

  status        UserStatus @default(PENDING)
  inviteToken   String?
  inviteExpires DateTime?

  memberships  UserBarbershop[]
  isSuperAdmin Boolean          @default(false)

  // Se o usuário for um barbeiro, ele estará linkado ao perfil dele
  barberId String? @unique
  barber   Barber? @relation(fields: [barberId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserBarbershop {
  userId       String
  barbershopId String
  role         Role   @default(ADMIN)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@id([userId, barbershopId]) // Chave primária composta
}

model Barber {
  id        String  @id @default(uuid())
  name      String
  phone     String?
  email     String  @unique // Adicionado para o envio do convite
  openTime  String
  openDays  String[]
  closeTime String
  status    Boolean @default(true) 

  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])

  user         User? 
  appointments Appointment[]
  services     Service[] 
  clients      Client[] 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id       String  @id @default(uuid())
  name     String
  price    Decimal @db.Decimal(10, 2)
  duration Int // Duração em minutos
  status   Boolean @default(true)

  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])

  barberId String? // Opcional: Se nulo, é um serviço global da barbearia
  barber   Barber? @relation(fields: [barberId], references: [id])

  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id       String  @id @default(uuid())
  name     String
  phone    String
  notes    String? @db.Text

  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])

  barberId String? 
  barber   Barber? @relation(fields: [barberId], references: [id])

  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([phone, barbershopId])
}

model Appointment {
  id        String   @id @default(uuid())
  date      DateTime @db.Date
  startTime String // Ex: "14:00"
  endTime   String // Ex: "14:30"
  price     Decimal  @db.Decimal(10, 2)
  status    String   @default("AGENDADO")

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  barberId String
  barber   Barber @relation(fields: [barberId], references: [id])

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
